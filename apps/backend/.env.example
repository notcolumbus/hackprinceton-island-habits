KNOT_ENVIRONMENT=production
KNOT_CLIENT_ID=your_knot_client_id
KNOT_SECRET=your_knot_secret
CONVEX_URL=https://tidy-vole-519.convex.cloud

# K2 Think V2 (MBZUAI-IFM) — open reasoning model
K2_API_KEY=your_k2_api_key
K2_API_URL=https://api.k2think.ai/v1/chat/completions
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# Google Gemma vision (photo auto-check-in classifier)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemma-4-26b-a4b-it
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta

# Dedalus Labs — persistent sandbox machines for hosting
DEDALUS_API_KEY=your_dedalus_api_key
